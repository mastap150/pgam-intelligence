# /etc/attune-bridge.env   — chmod 600, owned by root. Never commit the real one.

# Numbers leased to visitors. All must forward to the client's main line.
ATTUNE_POOL=+14055550101,+14055550102,+14055550103,+14055550104

# Shown when every number is in use. Unattributed, but the page still works.
ATTUNE_FALLBACK_NUMBER=+14055559999

ATTUNE_PIXEL_ID=REPLACE_ME

# Shared secret for /v1/call. Generate: openssl rand -hex 32
# Without it anyone who learns the URL can post fake conversions.
ATTUNE_CALL_TOKEN=REPLACE_ME

# Proxies between the internet and this process. Direct=0, one nginx/CDN=1,
# CDN+load balancer=2. Wrong value = every conversion attributed to a proxy,
# silently. Verify against a known external IP before trusting it.
ATTUNE_TRUSTED_PROXY_HOPS=1

ATTUNE_DB=/opt/attune-bridge/bridge.db
PORT=8088

# Set to 1 for the first shakedown: logs conversions instead of sending them.
ATTUNE_DRY_RUN=1
