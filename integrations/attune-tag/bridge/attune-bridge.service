# /etc/systemd/system/attune-bridge.service
# systemctl daemon-reload && systemctl enable --now attune-bridge
[Unit]
Description=Attune Call Bridge
After=network-online.target

[Service]
Type=simple
User=attune
WorkingDirectory=/opt/attune-bridge
EnvironmentFile=/etc/attune-bridge.env
ExecStart=/usr/bin/python3 /opt/attune-bridge/bridge.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/attune-bridge

[Install]
WantedBy=multi-user.target
