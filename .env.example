# ---------------------------------------------------------------------------
# MSN Partner Hub credentials (BoxingNews — partnerId AA1lKiff)
# Used by the MSN insights puller (agents/etl/msn_insights_etl.py).
# Playwright performs a one-time interactive login (handles MFA if prompted)
# and persists a browser profile under ~/.pgam/msn-session/ for subsequent runs.
# Rotate these by simply replacing the values here — no other config needs to change.
# ---------------------------------------------------------------------------
MSN_EMAIL=
MSN_PASSWORD=

# Optional: path Playwright uses to persist the logged-in browser profile.
# Defaults to ~/.pgam/msn-session if unset. Delete that directory to force re-login.
# MSN_SESSION_DIR=

# Optional: set to "0" to force a visible Chromium window (needed for the
# very first run, or to debug auth/MFA issues). Defaults to headless
# whenever a session profile already exists.
# MSN_HEADLESS=0

# Set to "1" to wire the MSN puller, resolver, and health alert into
# scheduler.py. Default off because Playwright/Chromium can't fit on
# Render's free Python tier; on a Playwright-capable host (local dev,
# Docker, GH Actions) flip this to "1".
# PGAM_MSN_PULLER_ENABLED=1

# Neon DSN that the MSN ETL writes to. Same DB the partner-revenue ETL
# uses — set once and both are happy. Falls back to DATABASE_URL.
# PGAM_DIRECT_DATABASE_URL=postgres://...

# Read-only DSN for the healthnation.com content DB (the `healthnation`
# schema written by the healthnation-web Next.js app). Only consumer today
# is scripts/healthnation_affiliate_audit.py. Copy the value from
# healthnation-web/.env.local DATABASE_URL, or the healthnation-web project
# env in Vercel. Kept distinct from PGAM_DIRECT_DATABASE_URL so a
# pgam-intelligence agent cannot accidentally write to healthnation.
# HEALTHNATION_DATABASE_URL=postgres://...

# Origin the affiliate audit's --check-live flag fetches to confirm
# AMAZON_PARTNER_TAG is live in prod. Defaults to https://healthnation.com.
# HEALTHNATION_SITE_URL=https://healthnation.com

# CJ Affiliates (Commission Junction) publisher account. Only consumer today
# is scripts/cj_healthnation_prospect.py, which searches CJ's open product
# catalog for advertisers matching healthnation.com's content lanes.
# Read-only — it joins nothing and writes nothing.
#
# Same PAT as mastap150/destination-com .env.local. Regenerate at
# developers.cj.com -> Authentication -> Personal Access Token.
# CJ_PAT=
#
# Publisher company id. Defaults to 7112482 (PGAM's CJ account) if unset.
# CJ_CID=7112482
#
# Per-property website id for healthnation.com. NOT the company id, and NOT
# destination.com's 101849129 -- CJ errors with "cannot access requested
# publisherid" if you mint a link against a PID the token can't reach.
# Leave unset until healthnation.com is added as a website under the CID;
# the script skips link minting and says so.
# CJ_HEALTHNATION_WEBSITE_ID=

# ---------------------------------------------------------------------------
# Supply Compliance & Quality Intelligence agent (Phase 1)
# Daily audit of partner ads.txt against PGAM's sellers.json. Writes findings
# to pgam_direct.compliance_findings + posts a Slack digest.
# ---------------------------------------------------------------------------
# Set to "1" to register the daily 08:30 ET scheduler job.
# PGAM_COMPLIANCE_ENABLED=1
#
# Override the sellers.json URL (the account-scoped path can rotate).
# PGAM_SELLERS_JSON_URL=https://sellers.pgamssp.com/<account>/sellers.json
#
# Limit publishers scanned per run (useful for dev/staging — leave unset in prod).
# PGAM_COMPLIANCE_LIMIT=10
#
# Also fetch + validate /app-ads.txt for each domain (404s tolerated).
# PGAM_COMPLIANCE_APP_ADS_TXT=1
#
# Global crawl rate cap, requests per second (default 2.0).
# PGAM_COMPLIANCE_RATE_HZ=2.0
#
# Phase 2 — conditional RESELLER-line validation. Defaults ON.
# Set to "0" to skip if ll_daily_partner_revenue is stale or you're
# tuning the LL publisher↔domain bridge match thresholds.
# PGAM_COMPLIANCE_RESELLERS=1
#
# Phase 3 — downstream SSP sellers.json audit. Confirms PGAM's seat
# exists in each Rubicon/PubMatic/etc sellers.json. Defaults ON.
# PGAM_COMPLIANCE_DOWNSTREAM=1
#
# Phase 3 — per-publisher compliance score (0..100) snapshotted daily
# into pgam_direct.compliance_publisher_scores_daily. Defaults ON.
# PGAM_COMPLIANCE_SCORING=1
#
# Phase 4 — static schain audit on LL demands + publishers. Defense-in-
# depth audit of supplyChainEnabled / dontAddSupplyChainNode flags;
# complements (does NOT duplicate) the auto-fixer in
# agents/optimization/config_health_scanner.py. Requires LL_UI_EMAIL +
# LL_UI_PASSWORD; degrades to a logged skip if absent. Defaults ON.
# PGAM_COMPLIANCE_SCHAIN=1
#
# Phase 5 — per-app + per-domain compliance audit (LL "Suppliers" view
# granularity). Pulls top N entities by trailing 7d revenue from
# pgam_direct.ll_daily_publisher_{domain,bundle}_demand, audits each
# with the tiered seller_id check + per-entity conditional reseller
# lines. Defaults ON.
# PGAM_COMPLIANCE_PHASE5=1
#
# Top N entities to audit per Phase 5 run (default 200).
# PGAM_COMPLIANCE_PHASE5_TOP_N=200
#
# Dedicated Slack webhook for the daily compliance digest. If set, the
# digest posts here (recommended: a new #compliance channel) instead of
# the shared SLACK_WEBHOOK. Create at https://api.slack.com/apps →
# your app → Incoming Webhooks → Add New Webhook to Workspace, target
# #compliance.
# COMPLIANCE_SLACK_WEBHOOK=https://hooks.slack.com/services/...

# ---------------------------------------------------------------------------
# PubMatic Activate (curator API) — core/pubmatic_activate.py
# Seat: PGAM_Activate_US (organizationid = 17496).
#
# PubMatic uses OAuth 2.0 (client_secret_basic). A Developer Integration
# is FOUR values, not two — access + refresh alone won't refresh.
#   Well-known:   https://api.pubmatic.com/.well-known/oauth-authorization-server
#   Token URL:    https://apps.pubmatic.com/v1/developer-integrations/developer/token
#
# Two auth modes are supported; set one full credential set:
#
#   Mode A — OAuth 2.0 (production; auto-refreshes on 401)
#     PUBMATIC_ACTIVATE_CLIENT_ID=
#     PUBMATIC_ACTIVATE_CLIENT_SECRET=
#     PUBMATIC_ACTIVATE_TOKEN=
#     PUBMATIC_ACTIVATE_REFRESH_TOKEN=
#
#   Mode B — session 'pubtoken' captured from the Activate UI (DevTools
#            → Network → any XHR → Request Headers → pubtoken). Works
#            today; expires when the browser logs out. Ad-hoc scripts only.
#     PUBMATIC_ACTIVATE_PUBTOKEN=
#
# Required regardless of auth mode:
# PUBMATIC_ACTIVATE_ORG_ID=17496

# Monday.com — Admin → Developers → My access tokens
MONDAY_API_TOKEN=

# ---------------------------------------------------------------------------
# TBX — new Teqblaze platform (api.pgammedia.com)
#
# A SECOND, DIFFERENT platform from the legacy TB_* one above
# (ssp.pgammedia.com). Different host, JWT bearer auth, different entity
# model, non-portable IDs. Both are live; neither replaces the other.
#
# Client:  core/tbx_api.py (reads) + core/tbx_mgmt.py (writes)
# Probe:   python3 scripts/tbx_probe.py --reports
# Spec:    docs/api/teqblaze-openapi.json
# Notes:   docs/teqblaze-new-platform.md
#
# Prod values live in the RENDER dashboard, not Vercel (see CLAUDE.md).
# ---------------------------------------------------------------------------
TBX_EMAIL=
TBX_PASSWORD=

# Override the API host (defaults to https://api.pgammedia.com).
# TBX_API_BASE=https://api.pgammedia.com

# Report timezone. Defaults to US/Eastern to match the scheduler's TZ and
# the LL / legacy-TB reporting convention.
# TBX_TIMEZONE=US/Eastern

# ── Write gates (both must be opened for anything to mutate) ───────────────
#
# Every writer in core/tbx_mgmt.py defaults to dry_run=True, AND refuses a
# live write unless TBX_ALLOW_WRITES=1. Two locks, because the update
# endpoints replace whole objects — a malformed payload blanks config.
#
# Prerequisites before setting this to 1:
#   1. scripts/tbx_probe.py --diff-shape supply:<id> reports a lossless
#      read→write round trip (and the same for demand:<id>)
#   2. PROTECTED_FLOOR_MINIMUMS in core/tbx_mgmt.py is populated with THIS
#      platform's IDs — contract floors are otherwise unenforced here
# TBX_ALLOW_WRITES=1
#
# Set to "false" to let callers that pass dry_run=None write for real
# (still subject to TBX_ALLOW_WRITES). Defaults to dry.
# TBX_DRY_RUN=false

# Largest single-run floor move, as a fraction. Default 0.25 (±25%).
# The legacy platform's every-2h tuner moved floors ±39% in one run and
# tanked revenue (2026-04-24); this cap makes that impossible.
# TBX_MAX_FLOOR_DELTA=0.25

# Minimum seconds between API calls. Conservative default because the new
# platform's rate limits are undocumented — the legacy API allowed only one
# concurrent query per user.
# TBX_MIN_INTERVAL=0.25
# TBX_TIMEOUT=60
# TBX_MAX_RETRIES=3
