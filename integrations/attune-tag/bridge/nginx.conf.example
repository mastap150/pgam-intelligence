# TLS terminates here, so the bridge itself never needs a certificate.
# This is ONE proxy hop => ATTUNE_TRUSTED_PROXY_HOPS=1
server {
    listen 443 ssl http2;
    server_name bridge.pgammedia.com;

    ssl_certificate     /etc/letsencrypt/live/bridge.pgammedia.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/bridge.pgammedia.com/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:8088;
        proxy_set_header Host              $host;
        # Appends the address nginx received the request from. The bridge walks
        # back TRUSTED_PROXY_HOPS entries from the end to find the real visitor.
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 15s;
    }
}
